# M1 Bite1 相对 M0 完结版的架构变动图
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

classes: {
  new: {
    style: {
      fill: "#ede9fe"
      stroke: "#7c3aed"
      stroke-width: 3
      font-color: "#111827"
      border-radius: 10
      bold: true
      font-size: 13
    }
  }
  changed: {
    style: {
      fill: "#fef3c7"
      stroke: "#d97706"
      stroke-width: 2
      font-color: "#111827"
      border-radius: 10
      bold: true
      font-size: 13
    }
  }
  unchanged: {
    style: {
      fill: "#f3f4f6"
      stroke: "#9ca3af"
      font-color: "#6b7280"
      border-radius: 10
      font-size: 13
    }
  }
  e_new: {
    style: {
      stroke: "#10b981"
      stroke-width: 3
      font-color: "#047857"
      bold: true
      font-size: 11
    }
  }
  e_changed: {
    style: {
      stroke: "#d97706"
      stroke-width: 2
      font-color: "#92400e"
      bold: true
      font-size: 11
    }
  }
  e_unchanged: {
    style: {
      stroke: "#9ca3af"
      stroke-width: 1
      font-color: "#9ca3af"
      stroke-dash: 3
      font-size: 11
    }
  }
}

title: |md
  **M1 Bite1 相对 M0 的架构变动**

  新增：limine_fb / console / font / fb / 显存 / qemu 图形 ｜ 改动：_start、limine.conf ｜ 未动：构建链 / 引导 / serial / COM1
| {
  near: top-center
  shape: text
}

docker: "构建容器\n未动" { class: unchanged }
limine_conf: "limine.conf\n【改】resolution" { class: changed }
iso: "kernel.iso\n未动" { class: unchanged }
seabios: "SeaBIOS\n未动" { class: unchanged }
limine: "Limine\n未动" { class: unchanged }

docker -> iso: "make -C impl build" { class: e_unchanged }
limine_conf -> iso: "打进 ISO" { class: e_changed }
iso -> seabios: "qemu -cdrom" { class: e_unchanged }
seabios -> limine: "El Torito" { class: e_unchanged }

kernel: "kernel（信任边界）" {
  style: {
    fill: "#f9fafb"
    stroke: "#9ca3af"
    stroke-dash: 4
    border-radius: 16
    bold: true
    font-color: "#9ca3af"
  }

  start: "_start\n【改】取FB+画字+串口" { class: changed }
  limine_fb: "limine_fb\n【新】请求/响应" { class: new }
  console: "console\n【新】write_str" { class: new }
  kfont: "font\n【新】glyph" { class: new }
  fb: "fb\n【新】put_pixel" { class: new }
  serial: "serial\n未动" { class: unchanged }

  start -> limine_fb: "【新】first_framebuffer()" { class: e_new }
  start -> console: "【新】clear+write_str" { class: e_new }
  start -> serial: "【改】同内容+FB元数据" { class: e_changed }
  console -> kfont: "【新】glyph(ch)" { class: e_new }
  console -> fb: "【新】put_pixel" { class: e_new }
}

limine -> kernel.start: "交付 CPU" { class: e_unchanged }
limine -> kernel.limine_fb: "【新】填写 FB response" { class: e_new }

vram: "线性显存\n【新】" { class: new }
qemu_gfx: "qemu 图形\n【新】" { class: new }
com1: "COM1\n未动" { class: unchanged }
qemu_term: "qemu 终端\n未动" { class: unchanged }

kernel.fb -> vram: "【新】RGB 像素" { class: e_new }
vram -> qemu_gfx: "【新】guest→窗口" { class: e_new }
kernel.serial -> com1: "写 16550" { class: e_unchanged }
com1 -> qemu_term: "文本流" { class: e_unchanged }

legend: |md
  紫填充=新增 · 琥珀=改动 · 灰=未动 · 绿粗边=新增边 · 琥珀边=改动边 · 灰虚线=未动边
| {
  near: bottom-center
  shape: text
}

footer: "Style 1 · d2/ELK · M1 Bite1 vs M0" {
  near: bottom-center
  shape: text
  style.font-size: 11
  style.font-color: "#64748b"
}
