# M1 Bite2 相对 Bite1 的架构变动图：新增边 console→serial（双写收进 console）；start→console / start→serial 边改契约
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

classes: {
  new: {
    style: {
      fill: "#ede9fe"
      stroke: "#7c3aed"
      stroke-width: 3
      font-color: "#111827"
      border-radius: 10
      bold: true
      font-size: 13
    }
  }
  changed: {
    style: {
      fill: "#fef3c7"
      stroke: "#d97706"
      stroke-width: 2
      font-color: "#111827"
      border-radius: 10
      bold: true
      font-size: 13
    }
  }
  unchanged: {
    style: {
      fill: "#f3f4f6"
      stroke: "#9ca3af"
      font-color: "#6b7280"
      border-radius: 10
      font-size: 13
    }
  }
  e_new: {
    style: {
      stroke: "#10b981"
      stroke-width: 3
      font-color: "#047857"
      bold: true
      font-size: 11
    }
  }
  e_changed: {
    style: {
      stroke: "#d97706"
      stroke-width: 2
      font-color: "#92400e"
      bold: true
      font-size: 11
    }
  }
  e_unchanged: {
    style: {
      stroke: "#9ca3af"
      stroke-width: 1
      font-color: "#9ca3af"
      stroke-dash: 3
      font-size: 11
    }
  }
}

title: |md
  **M1 Bite2 相对 Bite1 的架构变动**

  新增边：console→serial（双写收进 console）｜ 边改契约：start→console（init + printk!）、start→serial（早期降级直写）｜ 模块内部改动：console（fmt::Write / printk! / 滚屏触发）、fb（scroll_up）
| {
  near: top-center
  shape: text
}

docker: "构建容器\n未动" { class: unchanged }
limine_conf: "limine.conf\n未动" { class: unchanged }
iso: "kernel.iso\n未动" { class: unchanged }
seabios: "SeaBIOS\n未动" { class: unchanged }
limine: "Limine\n未动" { class: unchanged }

docker -> iso: "make -C impl build" { class: e_unchanged }
limine_conf -> iso: "打进 ISO" { class: e_unchanged }
iso -> seabios: "qemu -cdrom" { class: e_unchanged }
seabios -> limine: "El Torito" { class: e_unchanged }

kernel: "kernel（信任边界）" {
  style: {
    fill: "#f9fafb"
    stroke: "#9ca3af"
    stroke-dash: 4
    border-radius: 16
    bold: true
    font-color: "#9ca3af"
  }

  start: "_start\n未动" { class: unchanged }
  limine_fb: "limine_fb\n未动" { class: unchanged }
  console: "console\n【改·内部】fmt::Write\nprintk! / 滚屏触发" { class: changed }
  kfont: "font\n未动" { class: unchanged }
  fb: "fb\n【改·内部】scroll_up" { class: changed }
  serial: "serial\n未动" { class: unchanged }

  start -> limine_fb: "first_framebuffer()" { class: e_unchanged }
  start -> console: "【改】init + printk!" { class: e_changed }
  start -> serial: "【改】早期降级直写" { class: e_changed }
  console -> kfont: "glyph(ch)" { class: e_unchanged }
  console -> fb: "put_pixel" { class: e_unchanged }
  console -> serial: "【新】镜像字节流（双写）" { class: e_new }
}

limine -> kernel.start: "交付 CPU" { class: e_unchanged }
limine -> kernel.limine_fb: "填写 FB response" { class: e_unchanged }

vram: "线性显存\n未动" { class: unchanged }
qemu_gfx: "qemu 图形\n未动" { class: unchanged }
com1: "COM1\n未动" { class: unchanged }
qemu_term: "qemu 终端\n未动" { class: unchanged }

kernel.fb -> vram: "RGB 像素" { class: e_unchanged }
vram -> qemu_gfx: "guest→窗口" { class: e_unchanged }
kernel.serial -> com1: "写 16550" { class: e_unchanged }
com1 -> qemu_term: "文本流" { class: e_unchanged }

legend: |md
  琥珀=内部改动（模块/接口不变） · 灰=未动 · 绿粗实线=新增边 · 琥珀边=改契约边 · 灰虚线=未动边
| {
  near: bottom-center
  shape: text
}

footer: "Style 1 · d2/ELK · M1 Bite2 vs Bite1" {
  near: bottom-right
  shape: text
  style.font-size: 11
  style.font-color: "#64748b"
}
