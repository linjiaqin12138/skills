<?xml version='1.0' encoding='utf-8'?>
<!-- M8 BAM 默认场景：robot_groundcontact（sit/roulade 训练身体）+ 地板。

     robot_groundcontact.xml 来自 pollen-robotics/microduck_rl（Apache-2.0），
     详见 PROVENANCE.md。视觉设定照搬同仓库 scene.xml / 我们的 scene.xml。
     碰撞 geom 的 contype 默认为 1（与 walk 资产不同），可直接与地板接触；
     仍保留足底 pair，与 scene.xml 对齐、避免日后改 contype 时踩空。
     timestep 由 duck_body.py 在 BAM 路径写为 0.005（训练 CPU 蓝图值）。 -->
<mujoco model="microduck_scene_groundcontact">
  <compiler angle="radian" autolimits="true" />
  <option timestep="0.005" />
  <include file="robot_groundcontact.xml" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="160" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2" />
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />
  </worldbody>

  <!-- groundcontact 的 collision geom 默认 contype/conaffinity=1，可直接碰地板；
       不设 foot pair（与官方 scene.xml 一致）。walk 场景才需要 pair 补 contype=0。 -->

  <sensor>
    <!-- duck_body.py 按此名读 gyro；与 RL 自带 imu_* 传感器并存。 -->
    <gyro name="imu_gyro" site="imu" />
  </sensor>

  <keyframe>
    <!-- STAND = 控制侧 DEFAULT_POSITION = RL scene.xml STAND（数值逐位一致）。 -->
    <key name="STAND" qpos="0 0 0.12 1 0 0 0
         0 -0.08726646259971647 -0.457924 -0.004940 0.452984
         0.3490658503988659 0.3490658503988659 0 0
         0 0.08726646259971647 0.457924 0.004940 -0.452984" />
  </keyframe>
</mujoco>
