                <geom class="visual" pos="-0.006705 -0.007375 -0.015204" size="0.027705 0.018431 0.022607" />
                <!-- 脚掌：官方 sole_left 网格 AABB，步态接触就靠它 -->
                <geom name="left_foot_collision" class="collision" pos="-0.006832 -0.018218 -0.015741"
                      quat="0.4924 -0.508108 -0.489826 0.509351" size="0.006788 0.021741 0.02723" />
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- 头颈：neck_pitch → head_pitch → head_yaw → head_roll -->
      <body name="neck" pos="0.026 0.0145 0.0324215" quat="0 0 0.7071068 -0.7071068">
        <inertial mass="0.036841" pos="0 -0.025 0.014166"
                  quat="0.707107 0.707107 0 0" diaginertia="1.729e-05 1.637e-05 3.127e-06" />
        <joint axis="0 0 1" name="neck_pitch" type="hinge"
               range="-1.5707963267948974 1.0471975511965967" />
        <geom class="visual" pos="0 -0.025 0.014367" size="0.01 0.035749 0.014682" />

        <body name="neck_pitch" pos="0 -0.05 0" quat="0 1 0 0">
