                    quat="1 0 0 0" diaginertia="1.092e-06 9.669e-07 5.121e-07" />
          <joint axis="0 0 1" name="head_pitch" type="hinge"
                 range="-1.5707963267948966 1.5707963267948966" />
          <geom class="visual" pos="0 0.007209 -0.0145" size="0.014638 0.016209 0.0175" />

          <body name="yaw_roll_motion" pos="0 0.0186931 -0.0145" quat="0 0 -0.7071068 -0.7071068">
            <inertial mass="0.048600" pos="-0.000167 -0.00501 0.017806"
                      quat="0.174483 0.690172 -0.019258 0.702031"
                      diaginertia="9.655e-06 8.118e-06 6.888e-06" />
            <joint axis="0 0 1" name="head_yaw" type="hinge"
                   range="-2.9670597283903613 2.9670597283903595" />
            <geom class="visual" pos="-0.000669 -0.004207 0.019858" size="0.022609 0.028879 0.021577" />

            <body name="jaw_soft" pos="-0.0179 0 0.0145" quat="0.7071068 0 -0.7071068 0">
              <inertial mass="0.188766" pos="0.004605 0.0012 -0.032476"
                        quat="0.999608 0.020149 -0.019164 -0.003139"
                        diaginertia="3.211e-04 2.543e-04 1.495e-04" />
              <joint axis="0 0 1" name="head_roll" type="hinge"
                     range="-0.43633231299858327 0.4363323129985815" />
              <geom class="visual" pos="0.012099 -0.002213 -0.018294" size="0.04425 0.04987 0.071328" />
              <!-- 头部三碰撞盒：官方 top_head_shell / jaw / bottom_head_shell 网格 AABB -->
              <geom class="collision" pos="0.018532 0.000002 -0.021558"
                    quat="0.000058 0.998034 0.000007 0.062669" size="0.029943 0.045884 0.064822" />
              <geom class="collision" pos="-0.00902 -0.000234 -0.045215"
                    quat="-0.69899 0.706179 -0.078888 -0.08063" size="0.014671 0.038671 0.046233" />
              <geom class="collision" pos="-0.009131 -0.001532 -0.01299"
                    quat="0.001424 0.999847 0.002743 0.017243" size="0.012276 0.047571 0.065501" />
            </body>
          </body>
        </body>
      </body>

      <!-- 右腿：与左腿同构，body/joint 名是官方命名（hip_l_2 / leg_2 不是笔误） -->
      <body name="bearing_roll" pos="0.006 -0.0175 -0.005" quat="0 -0.7071068 -0.7071068 0">
        <inertial mass="0.023041" pos="0 0.000994 0.016892"
                  quat="0.99973 -0.023249 0 0" diaginertia="4.196e-06 3.420e-06 2.324e-06" />
        <joint axis="0 0 1" name="right_hip_yaw" type="hinge"
               range="-0.523598775598297 0.43633231299858416" />
        <geom class="visual" pos="0 -0.003828 0.013005" size="0.014638 0.020329 0.024065" />

        <body name="hip_l_2" pos="0 0.0165 0.0125" quat="0 0 0.7071068 0.7071068">
          <inertial mass="0.006189" pos="0.014815 0 -0.0083"
                    quat="0.94694 -0.000014 -0.321411 0.000039"
                    diaginertia="1.160e-06 1.158e-06 3.525e-07" />
          <joint axis="0 0 1" name="right_hip_roll" type="hinge"
                 range="-0.3839724354387507 0.38397243543875426" />
          <geom class="visual" pos="0.01146 0 -0.00705" size="0.024924 0.014638 0.026088" />
          <geom class="collision" pos="0.01146 0.000002 -0.006718"
                quat="0.662162 -0.248967 -0.248818 0.661549" size="0.009511 0.013456 0.022452" />

          <body name="upper_leg_right" pos="0.025 0 -0.0185" quat="0.5 -0.5 0.5 -0.5">
            <inertial mass="0.048207" pos="-0.006766 0.022884 0.013453"
                      quat="0.365786 0.583696 -0.374279 0.620818"
                      diaginertia="1.985e-05 1.911e-05 8.118e-06" />
            <joint axis="0 0 1" name="right_hip_pitch" type="hinge"
                   range="-1.57079632679494 1.570796326794853" />
            <geom class="visual" pos="-0.001918 0.027685 0.019744" size="0.04158 0.046051 0.032183" />

            <body name="leg_2" pos="-0.022 0.0357771 -0.004" quat="0 1 0 0">
              <inertial mass="0.021584" pos="-0.031894 0 -0.009535"
                        quat="0.570263 0.418091 0.418091 0.570263" diaginertia="5.251e-06 4.581e-06 1.914e-06" />
              <joint axis="0 0 1" name="right_knee" type="hinge"
                     range="-1.5707963267949339 1.5707963267948593" />
              <geom class="visual" pos="-0.0196 0 -0.009535" size="0.033149 0.01 0.01678" />
              <geom class="collision" pos="-0.017258 0 0.001867"
                    quat="0.696555 0.000001 0.717504 0.000001" size="0.00447 0.01 0.030688" />

              <body name="ankle_right" pos="-0.042 0 -0.026" quat="0 -0.7071068 -0.7071068 0">
                <inertial mass="0.030025" pos="0.006155 -0.013748 -0.015657"
                          quat="0.517424 0.501653 0.474682 0.505266"
                          diaginertia="1.116e-05 7.743e-06 5.903e-06" />
                <joint axis="0 0 1" name="right_ankle" type="hinge"
                       range="-1.5707963267949028 1.5707963267948903" />
                <geom class="visual" pos="0.006705 -0.007375 -0.015204" size="0.027705 0.018431 0.022607" />
                <geom name="right_foot_collision" class="collision" pos="0.006832 -0.018218 -0.015741"
                      quat="0.509351 0.489826 0.508109 0.492399" size="0.006788 0.021741 0.02723" />
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position class="duck" name="left_hip_yaw" joint="left_hip_yaw" />
    <position class="duck" name="left_hip_roll" joint="left_hip_roll" />
    <position class="duck" name="left_hip_pitch" joint="left_hip_pitch" />
    <position class="duck" name="left_knee" joint="left_knee" />
    <position class="duck" name="left_ankle" joint="left_ankle" />
    <position class="duck" name="neck_pitch" joint="neck_pitch" />
    <position class="duck" name="head_pitch" joint="head_pitch" />
    <position class="duck" name="head_yaw" joint="head_yaw" />
    <position class="duck" name="head_roll" joint="head_roll" />
    <position class="duck" name="right_hip_yaw" joint="right_hip_yaw" />
    <position class="duck" name="right_hip_roll" joint="right_hip_roll" />
    <position class="duck" name="right_hip_pitch" joint="right_hip_pitch" />
    <position class="duck" name="right_knee" joint="right_knee" />
    <position class="duck" name="right_ankle" joint="right_ankle" />
  </actuator>
</mujoco>
