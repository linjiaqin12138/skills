<?xml version="1.0" encoding="utf-8"?>
<!-- M9a Bite 1：自建鸭子身体 MJCF——零 STL、只用基本几何体。

     设计原则：
     - 惯量是数据不是形状：每个 body 的质量/质心/惯量主轴来自官方
       robot_groundcontact.xml 的编译输出（mjModel.body_mass/ipos/iquat/inertia，
       官方 XML 是 Apache-2.0），用显式 <inertial> 写入，逐位对齐。
     - 碰撞几何才讲形状：官方 10 个碰撞网格（trunk/hip×2/leg×2/foot×2/head×3）
       各取网格 AABB 写成 box——AABB 包围盒天然保守（只大不小），D26 收敛
       就靠这组 primitive-box 接触替掉 mesh-plane 接触。
     - 视觉几何取每 body 全部视觉网格的并集 AABB，一个 box 一个 body，
       纯观赏（contype=0）。
     - 关节树/关节名/文档序与官方逐一对齐：下游策略权重按关节顺序读写。
     - 关节与执行器参数取官方 chosen_actuator 类编译值：
       damping=0.053 frictionloss=0.0048 armature=0.0018，
       position kp=0.55 kv=0 forcerange=±0.96N·m ctrlrange=±10。 -->
<mujoco model="microduck_handmade">
  <compiler angle="radian" autolimits="true" />

  <default>
    <default class="duck">
      <joint damping="0.053" frictionloss="0.0048" armature="0.0018" />
      <position kp="0.55" kv="0.0" forcerange="-0.96 0.96" ctrlrange="-10.0 10.0" />
      <default class="visual">
        <geom type="box" contype="0" conaffinity="0" group="2" rgba="1 0.8 0.1 1" />
      </default>
      <default class="collision">
        <geom type="box" group="3" rgba="0.2 0.6 1 0.4" />
      </default>
    </default>
  </default>

  <worldbody>
    <body name="trunk_base" pos="0 0 0.12" childclass="duck">
      <freejoint name="trunk_base_freejoint" />
      <inertial mass="0.199224" pos="-0.022633 -0.000027 0.002801"
                quat="0.664866 0.238381 0.235012 0.667756"
                diaginertia="1.459e-04 1.408e-04 9.853e-05" />
      <site group="3" name="imu" pos="-0.021 0.0000664 -0.0146984" quat="1 0 0 0" />
      <geom class="visual" pos="-0.010311 0.000596 0.009162" size="0.048385 0.052674 0.053448" />
      <!-- 官方碰撞网格 np_f970（电池）的 AABB -->
      <geom class="collision" pos="-0.035593 -0.000007 -0.004094"
            quat="0.009019 0.00034 -0.999959 -0.000116" size="0.010659 0.019312 0.03564" />

      <!-- 左腿：yaw → roll → pitch → knee → ankle -->
      <body name="yaw2roll" pos="0.006 0.0175 -0.005" quat="0 -0.7071068 -0.7071068 0">
        <inertial mass="0.023041" pos="0 0.000994 0.016892"
                  quat="0.99973 -0.023249 0 0" diaginertia="4.196e-06 3.420e-06 2.324e-06" />
        <joint axis="0 0 1" name="left_hip_yaw" type="hinge"
               range="-0.4363323129985824 0.5235987755982988" />
        <geom class="visual" pos="0 -0.003828 0.013005" size="0.014638 0.020329 0.024065" />

        <body name="hip_l" pos="0 0.0165 0.0125" quat="0.7071068 -0.7071068 0 0">
          <inertial mass="0.006189" pos="0.014815 0 -0.0083"
                    quat="0.94694 -0.000014 -0.321411 0.000039"
                    diaginertia="1.160e-06 1.158e-06 3.525e-07" />
          <joint axis="0 0 1" name="left_hip_roll" type="hinge"
                 range="-0.3839724354386992 0.38397243543880577" />
          <geom class="visual" pos="0.01146 0 -0.00705" size="0.024924 0.014638 0.026088" />
          <geom class="collision" pos="0.01146 0.000002 -0.006718"
                quat="0.662162 -0.248967 -0.248818 0.661549" size="0.009511 0.013456 0.022452" />

          <body name="upper_leg_left" pos="0.025 0 -0.0185" quat="0.5 -0.5 0.5 -0.5">
            <inertial mass="0.048207" pos="0.006766 0.022884 0.013453"
                      quat="0.620818 0.374279 -0.583696 0.365786"
                      diaginertia="1.985e-05 1.911e-05 8.118e-06" />
            <joint axis="0 0 1" name="left_hip_pitch" type="hinge"
                   range="-1.570796326794949 1.5707963267948442" />
            <geom class="visual" pos="0.001918 0.027685 0.019744" size="0.04158 0.04605 0.032184" />

            <body name="leg" pos="0.022 0.0357771 -0.004" quat="0 0.7071068 0.7071068 0">
              <inertial mass="0.021584" pos="0 0.031894 -0.009535"
                        quat="0.806473 0.591271 0 0" diaginertia="5.251e-06 4.581e-06 1.914e-06" />
              <joint axis="0 0 1" name="left_knee" type="hinge"
                     range="-1.5707963267948983 1.5707963267948948" />
              <geom class="visual" pos="0 0.0196 -0.009535" size="0.01 0.033149 0.01678" />
              <geom class="collision" pos="0 0.017258 0.001867"
                    quat="0.492539 0.507352 0.507351 -0.492538" size="0.00447 0.01 0.030688" />

              <body name="ankle_left" pos="0 0.042 -0.026" quat="0 -1 0 0">
                <inertial mass="0.030025" pos="-0.006157 -0.013748 -0.015658"
                          quat="0.474723 0.505182 0.517427 0.501696"
                          diaginertia="1.116e-05 7.743e-06 5.903e-06" />
                <joint axis="0 0 1" name="left_ankle" type="hinge"
